{
  "name": "game-editor-membership-preparation",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test test/spark-unit.test.cjs test/gate.test.cjs",
    "emulators": "firebase emulators:start --project demo-game-editor-membership",
    "test:emulator": "firebase emulators:exec --project demo-game-editor-membership --only auth,firestore \"node --test test/spark-emulator.test.cjs\"",
    "test:full": "firebase emulators:exec --project demo-game-editor-membership --only auth,firestore \"node test/run-local-tests.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "15.34.0",
    "playwright": "1.62.1"
  }
}
